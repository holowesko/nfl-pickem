# Neon Postgres connection string (https://neon.tech - free tier is plenty).
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# The Odds API key for point spreads (https://the-odds-api.com - free tier).
ODDS_API_KEY=""

# Shared secret the scheduled jobs send as `Authorization: Bearer <secret>`
# so that only our own cron can trigger line snapshots and scoring.
CRON_SECRET=""

# Season the app should show.
NEXT_PUBLIC_SEASON="2026"
