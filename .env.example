# Neon Postgres connection string (https://neon.tech - free tier is plenty).
# Leave this unset in local development to use an embedded PGlite database
# stored in .pglite/ - no account or install needed.
DATABASE_URL=""

# Shared secret the scheduled sync job sends as `Authorization: Bearer <secret>`
# so that only our own cron can trigger it.
CRON_SECRET=""
